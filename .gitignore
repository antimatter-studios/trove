/target
# keepass-spec-tests is its own workspace (excluded from the root workspace), so
# its build output lands in a nested target dir the root `/target` rule misses.
/crates/keepass-spec-tests/target/
.history/
.secrets
.DS_Store
*.swp
# Never commit a vault by accident — except curated test fixtures. The `**/`
# matters: without it the negation anchors to the repo root, so a fixture under
# e.g. crates/troved/tests/fixtures/ is silently ignored and `git add` no-ops.
*.kdbx
!**/fixtures/*.kdbx
