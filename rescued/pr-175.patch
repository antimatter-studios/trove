Subject: [PATCH] fix(kdf): reject invalid Argon2 parameters

---
 crates/trove-cli/src/main.rs              | 21 +++++++++--
 crates/trove-core/src/lib.rs              | 25 ++++++++++++-
 crates/trove-core/tests/kdf_validation.rs | 44 +++++++++++++++++++++++
 3 files changed, 87 insertions(+), 3 deletions(-)
 create mode 100644 crates/trove-core/tests/kdf_validation.rs

diff --git a/crates/trove-cli/src/main.rs b/crates/trove-cli/src/main.rs
index ec43695..aaf81a3 100644
--- a/crates/trove-cli/src/main.rs
+++ b/crates/trove-cli/src/main.rs
@@ -611,7 +611,7 @@ enum Command {
         /// Remove the keyfile requirement (password-only afterwards).
         #[arg(long = "unset-key-file", conflicts_with = "set_key_file")]
         unset_key_file: bool,
-        /// Argon2 memory in MiB.
+        /// Argon2 memory in MiB (must be at least 1; KeePassXC bounds apply).
         #[arg(long = "kdf-memory", value_name = "MIB")]
         kdf_memory: Option<u64>,
         /// Argon2 iterations.
@@ -4935,7 +4935,7 @@ fn cmd_db_edit(
 
     if any_kdf {
         v.set_argon2_params(
-            kdf_memory.map(|m| m * 1024),
+            kdf_memory.map(mib_to_kib).transpose()?,
             kdf_iterations,
             kdf_parallelism,
         )
@@ -4945,6 +4945,12 @@ fn cmd_db_edit(
     Ok(())
 }
 
+fn mib_to_kib(memory_mib: u64) -> Result<u64> {
+    memory_mib
+        .checked_mul(1024)
+        .ok_or_else(|| anyhow!("--kdf-memory is too large to convert from MiB to KiB"))
+}
+
 /// `trove db-info` — non-secret database facts.
 fn cmd_db_info(vault_path: &Path, pw_stdin: bool, json: bool) -> Result<()> {
     let v = open_vault(vault_path, pw_stdin)?;
@@ -6249,3 +6255,14 @@ mod unlock_mode_tests {
         assert_eq!(sh_single_quote("it's"), r"'it'\''s'");
     }
 }
+
+#[cfg(test)]
+mod kdf_memory_conversion_tests {
+    use super::*;
+
+    #[test]
+    fn mib_to_kib_checks_overflow() {
+        assert_eq!(mib_to_kib(64).unwrap(), 64 * 1024);
+        assert!(mib_to_kib(u64::MAX).is_err());
+    }
+}
diff --git a/crates/trove-core/src/lib.rs b/crates/trove-core/src/lib.rs
index b824b53..963a255 100644
--- a/crates/trove-core/src/lib.rs
+++ b/crates/trove-core/src/lib.rs
@@ -1414,6 +1414,27 @@ impl Vault {
         iterations: Option<u64>,
         parallelism: Option<u32>,
     ) -> Result<()> {
+        if let Some(memory) = memory_kib {
+            if !(8..(1u64 << 32)).contains(&memory) {
+                return Err(Error::Kdbx(
+                    "Argon2 memory must be between 8 KiB and less than 2^32 KiB".into(),
+                ));
+            }
+        }
+        if let Some(iterations) = iterations {
+            if !(1..=i32::MAX as u64).contains(&iterations) {
+                return Err(Error::Kdbx(
+                    "Argon2 iterations must be between 1 and 2^31-1".into(),
+                ));
+            }
+        }
+        if let Some(parallelism) = parallelism {
+            if !(1..(1 << 24)).contains(&parallelism) {
+                return Err(Error::Kdbx(
+                    "Argon2 parallelism must be between 1 and less than 2^24".into(),
+                ));
+            }
+        }
         match &mut self.inner.db.config.kdf_config {
             keepass::config::KdfConfig::Argon2 {
                 iterations: it,
@@ -1422,7 +1443,9 @@ impl Vault {
                 ..
             } => {
                 if let Some(m) = memory_kib {
-                    *memory = m;
+                    *memory = m
+                        .checked_mul(1024)
+                        .ok_or_else(|| Error::Kdbx("Argon2 memory value overflows bytes".into()))?;
                 }
                 if let Some(i) = iterations {
                     *it = i;
diff --git a/crates/trove-core/tests/kdf_validation.rs b/crates/trove-core/tests/kdf_validation.rs
new file mode 100644
index 0000000..a7a6e3d
--- /dev/null
+++ b/crates/trove-core/tests/kdf_validation.rs
@@ -0,0 +1,44 @@
+//! Argon2 KDF settings cannot be saved outside KeePassXC-compatible bounds.
+
+#![allow(missing_docs)]
+
+use tempfile::TempDir;
+use trove_core::Vault;
+
+#[test]
+fn set_argon2_params_rejects_zero_and_out_of_range_values_without_saving() {
+    let dir = TempDir::new().unwrap();
+    let path = dir.path().join("kdf.kdbx");
+    let mut vault = Vault::create(&path, "password").unwrap();
+    let before = vault.db_info().kdf;
+    let file_before = std::fs::read(&path).unwrap();
+
+    for (memory, iterations, parallelism) in [
+        (None, Some(0), None),
+        (None, None, Some(0)),
+        (Some(0), None, None),
+        (Some(7), None, None),
+        (Some(1 << 32), None, None),
+        (None, Some(i32::MAX as u64 + 1), None),
+        (None, None, Some(1 << 24)),
+    ] {
+        assert!(
+            vault
+                .set_argon2_params(memory, iterations, parallelism)
+                .is_err(),
+            "accepted invalid KDF parameters: {memory:?} {iterations:?} {parallelism:?}"
+        );
+        assert_eq!(vault.db_info().kdf, before);
+        assert_eq!(std::fs::read(&path).unwrap(), file_before);
+    }
+}
+
+#[test]
+fn set_argon2_params_accepts_the_kee_pass_xc_minimums() {
+    let dir = TempDir::new().unwrap();
+    let path = dir.path().join("kdf-min.kdbx");
+    let mut vault = Vault::create(&path, "password").unwrap();
+    vault
+        .set_argon2_params(Some(8), Some(1), Some(1))
+        .expect("KeePassXC-compatible minimum values should be accepted");
+}
