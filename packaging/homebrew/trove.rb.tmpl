# typed: false
# frozen_string_literal: true

# GENERATED by the trove release pipeline (.github/workflows/release.yml).
# The `@...@` tokens are filled in at release time (version + per-target
# sha256) and the result is pushed to antimatter-studios/homebrew-tap as
# Formula/trove.rb. Do not hand-edit the copy in the tap — it is overwritten
# on the next release. Edit THIS template instead.
class Trove < Formula
  desc "KeePassXC-compatible secrets daemon for developer machines"
  homepage "https://github.com/antimatter-studios/trove"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]
  head "https://github.com/antimatter-studios/trove.git", branch: "main"

  on_macos do
    on_arm do
      url "https://github.com/antimatter-studios/trove/releases/download/v#{version}/trove-#{version}-darwin-arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/antimatter-studios/trove/releases/download/v#{version}/trove-#{version}-darwin-x86_64.tar.gz"
      sha256 "@SHA_DARWIN_X86_64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/antimatter-studios/trove/releases/download/v#{version}/trove-#{version}-linux-arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/antimatter-studios/trove/releases/download/v#{version}/trove-#{version}-linux-x86_64.tar.gz"
      sha256 "@SHA_LINUX_X86_64@"
    end
  end

  def install
    bin.install "trove", "troved"
  end

  # `brew services start trove` runs troved at login and restarts it if it
  # dies. `--resident` keeps it up after a lock so the agent sockets stay
  # available. It doesn't touch gpg's socket; that symlink stays manual.
  service do
    run [opt_bin/"troved", "--resident"]
    keep_alive successful_exit: false, crashed: true
    log_path var/"log/troved.log"
    error_log_path var/"log/troved.log"
  end

  def caveats
    <<~EOS
      Two binaries installed:
        trove   — CLI client
        troved  — long-running daemon (auto-spawned by trove on first use)

      To run troved at login instead:
        brew services start trove

      Quickstart:
        trove unlock ~/path/to/your.kdbx     # starts troved if needed
        export SSH_AUTH_SOCK="$(trove ssh-agent socket)"
        ssh-add -L

      For GPG signing (git commit -S):
        ln -sf "$(trove gpg-agent socket)" "${GNUPGHOME:-$HOME/.gnupg}/S.gpg-agent"

      Windows: this Linux build works as-is inside WSL2. For native Windows
      (PowerShell, Git for Windows) install with Scoop instead; see
      https://github.com/antimatter-studios/trove#windows

      Full quickstart + threat model:
        https://github.com/antimatter-studios/trove#quickstart
    EOS
  end

  test do
    # Exercises clap's --version path; asserts it matches the formula version.
    assert_match version.to_s, shell_output("#{bin}/trove --version")
    # troved is present and executable.
    assert_path_exists bin/"troved"
    assert_predicate bin/"troved", :executable?
  end
end
